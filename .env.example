# Django secret key (required). Generate one with: uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
# Enable Django debug mode ("true"/"false"); keep false outside local development.
DJANGO_DEBUG=true
# Comma-separated hostnames Django will serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Your Canvas instance URL, no trailing slash.
CANVAS_BASE_URL=https://school.test.instructure.com
# Developer key ID (the numeric "ID" column in Canvas > Admin > Developer Keys).
CANVAS_CLIENT_ID=10000000000001
# Developer key secret shown in Canvas > Admin > Developer Keys.
CANVAS_CLIENT_SECRET=your-developer-key-secret
# Must exactly match a redirect URI registered on the developer key.
CANVAS_REDIRECT_URI=http://localhost:8000/oauth/callback/
# Optional space-separated Canvas scopes; defaults to the courses endpoint only.
CANVAS_SCOPES=url:GET|/api/v1/courses
# Fernet key for encrypting tokens at rest. Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-with-44-char-fernet-key=
